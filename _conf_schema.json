{
  "style_presets": {
    "type": "list",
    "description": "画风预设",
    "hint": "每项格式为 名称｜画风说明。说明可写中文视觉特征、英文标签或指定权重串。",
    "default": []
  },
  "default_style": {
    "type": "string",
    "description": "默认画风名称",
    "hint": "填入上面某个预设的完整名称。留空表示仅在单次请求点名时启用。",
    "default": ""
  },
  "qq_forward_card": {
    "description": "QQ 用聊天记录卡片发送成图",
    "type": "bool",
    "default": true,
    "hint": "适用于 OneBot v11 的群聊和私聊。关闭后直接发送图片和种子。"
  },
  "api_token": {
    "description": "NovelAI Persistent API Token",
    "type": "string",
    "default": "",
    "hint": "也可通过 AstrBot 进程环境变量 NOVELAI_API_TOKEN 提供，环境变量优先。"
  },
  "model": {
    "description": "NovelAI 图像模型",
    "type": "string",
    "options": [
      "nai-diffusion-5-full",
      "nai-diffusion-5-curated"
    ],
    "default": "nai-diffusion-5-full"
  },
  "size": {
    "description": "生成画幅",
    "type": "string",
    "options": [
      "方形",
      "横图",
      "竖图"
    ],
    "default": "方形"
  },
  "steps": {
    "description": "采样步数",
    "type": "int",
    "default": 28,
    "minimum": 1,
    "maximum": 50
  },
  "scale": {
    "description": "提示词引导强度",
    "type": "float",
    "default": 5.0,
    "minimum": 1,
    "maximum": 10
  },
  "strength": {
    "description": "图生图变化强度",
    "type": "float",
    "default": 0.5,
    "minimum": 0.1,
    "maximum": 0.9
  },
  "noise": {
    "description": "图生图噪声",
    "type": "float",
    "default": 0.2,
    "minimum": 0,
    "maximum": 1
  }
}
